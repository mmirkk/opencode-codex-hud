{
  "name": "opencode-codex-hud",
  "version": "0.2.0",
  "description": "Plugin de OpenCode que muestra en el TUI la cuota real del plan ChatGPT (Codex): ventana de 5 h y semanal, reset, créditos, avisos al acercarse al límite y una tool para que el agente te notifique.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "codex",
    "chatgpt",
    "usage",
    "quota",
    "hud",
    "sidebar"
  ],
  "exports": {
    "./tui": "./src/tui.tsx",
    "./server": "./src/server.ts"
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.18.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.4.5",
    "@opentui/keymap": ">=0.4.5",
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^22.15.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.0",
    "zod": "^4.1.0"
  }
}
